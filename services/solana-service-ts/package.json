  "private": true,
  "description": "OPRAI Solana service — TypeScript rewrite using official protocol SDKs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc --project tsconfig.json --noCheck",
