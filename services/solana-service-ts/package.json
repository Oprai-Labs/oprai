    "@meteora-ag/dlmm": "^1.9.4",
    "@orca-so/common-sdk": "^0.6.4",
    "@orca-so/whirlpools-sdk": "^0.20.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.41-alpha",
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@streamflow/stream": "^11.3.1",
    "axios": "^1.6.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
