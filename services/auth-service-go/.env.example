# auth-service-go environment variables

# HTTP server port (default: 3010)
PORT=3010

# gRPC server port (default: 50051)
GRPC_PORT=50051

# JWT signing secret. MUST be changed in production.
OPRAI_JWT_SECRET=dev-insecure-secret-change

# Internal API key shared between gateway and services. MUST be changed in production.
OPRAI_INTERNAL_API_KEY=dev-internal-key-change

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/oprai

# Redis connection string (optional; falls back to in-memory nonce store)
REDIS_URL=redis://localhost:6379

# Database schema name (default: auth_schema)
DB_SCHEMA=auth_schema

# Environment (development | production)
NODE_ENV=development
# GO_ENV=development  # Alternative Go-native env var
