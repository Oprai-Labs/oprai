# OPRAI Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 48   → JWT secrets
#   openssl rand -base64 32   → API keys / internal keys
#   openssl rand -base64 24   → DB passwords
#
# NEVER commit a .env file with real credentials to version control.

# ──────────── Secrets ────────────
OPRAI_JWT_SECRET=replace-with-your-jwt-secret
OPRAI_INTERNAL_API_KEY=replace-with-your-internal-api-key
# Lighter perps agent-key encryption (Fernet). REQUIRED to use Lighter — must be
# its OWN secret, distinct from OPRAI_JWT_SECRET. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPRAI_LIGHTER_ENC_KEY=replace-with-a-generated-fernet-key
# Redis password (redis --requirepass). Use URL-safe chars only — it is embedded
# in REDIS_URL as redis://:PASSWORD@redis:6379. Generate with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-your-redis-password

# ──────────── Database ────────────
DB_SUPERUSER=postgres
DB_SUPERPASS=replace-with-your-db-password
DB_SUPERDB=oprai

# Per-service DB roles — required by: make init-roles
# Generate with: openssl rand -base64 24
AUTH_DB_PASS=replace-with-auth-db-password
CHAT_DB_PASS=replace-with-chat-db-password
SOLANA_DB_PASS=replace-with-solana-db-password
MEMORY_DB_PASS=replace-with-memory-db-password
ADMIN_DB_PASS=replace-with-admin-db-password

# ──────────── CORS ────────────
# In production set to your public origin, e.g. https://app.oprai.xyz
CORS_ORIGIN=http://localhost:3000

# ──────────── LLM models ────────────
# Models named by ROLE (responder = main chat, intent_classifier = pre-router).
# Provider switched via OPRAI_LLM_PROVIDER (openai|anthropic).
OPRAI_LLM_PROVIDER=openai
OPRAI_OPENAI_API_KEY=replace-with-your-openai-key
OPRAI_RESPONDER_MODEL_OPENAI=gpt-5.4-nano
OPRAI_RESPONDER_FALLBACK_MODEL_OPENAI=gpt-4o-mini
# OPRAI_ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# OPRAI_RESPONDER_MODEL_ANTHROPIC=claude-haiku-4-5
# OPRAI_INTENT_CLASSIFIER_MODEL=gpt-5.4-nano

# ──────────── Solana ────────────
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# URL of the TypeScript solana-service used as the Streamflow SDK proxy (runs on :3031)
STREAMFLOW_SDK_URL=http://localhost:3031

# ──────────── Market Data APIs (proxied via gateway) ────────────
# Leave unset to disable that data source. Never commit real values.
BIRDEYE_API_KEY=
JUPITER_API_KEY=
HELIUS_API_KEY=
TENSOR_API_KEY=
MAGIC_EDEN_API_KEY=
PINATA_JWT=
# OpenSea API v2 key — enables the OpenSea NFT marketplace on Robinhood Chain
# (collections/listings reads + Seaport buy). Unset disables OpenSea. Read
# server-side by solana-service; must be set in that service's env.
OPENSEA_API_KEY=
# EVM wallet portfolio (balances + metadata + USD prices, multichain) via
# Alchemy's Data API. Free key from dashboard.alchemy.com. Unset disables the
# /market/evm/portfolio endpoint.
ALCHEMY_API_KEY=
# EVM DeFi positions (protocol-labeled: Aave/Uniswap/Lido/...) via Moralis'
# Web3 Data API. Free key from admin.moralis.com. Unset disables
# /market/evm/positions.
MORALIS_API_KEY=

# ──────────── Multichain identity linking ────────────
# Bot token from @BotFather. Enables linking a Telegram identity to an account
# (Login Widget payloads are HMAC-verified by auth-service). Unset = Telegram
# linking is disabled and the endpoint returns "not configured".
OPRAI_TELEGRAM_BOT_TOKEN=

# ──────────── Telegram bot (services/oprai-tg-bot + oprai-tg-signer) ────────────
# Custodial conversational-DeFi bot. Reuses OPRAI_TELEGRAM_BOT_TOKEN above.
# The bot holds NO keys — custody + signing live in the isolated Rust signer.
OPRAI_TG_SIGNER_URL=http://127.0.0.1:3060
# Bot username (without @) — builds the account-linking deep-link
# https://t.me/<username>?start=<token>. Set to your BotFather bot's username.
OPRAI_TG_BOT_USERNAME=
# Dev/collection wallet that receives $OPRAI credit top-ups (burn is manual/off-bot
# for now; OPRAI_TG_BURN_BPS stays 0 until auto-burn is turned on).
OPRAI_TG_DEV_WALLET=0xb0E580Cf95E2B045b99b31ddF3137D3D88d55b8E
OPRAI_TG_BURN_BPS=0
# Vault (Transit engine) — used by the signer for envelope encryption of keys.
# Dev defaults match the in-memory Vault in docker-compose.infra.yml (run
# `make vault-init` once after `make dev-infra`). PROD uses a real, persistent,
# sealed Vault with a SCOPED token — never the dev root token.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=oprai-dev-root
VAULT_DEV_TOKEN=oprai-dev-root
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=oprai-tg-keys

# Relay.link app fee recipient — OPRAI wallet address (EVM or Solana)
# When set, 0.05% fee is automatically added to every Relay bridge quote.
RELAY_FEE_RECIPIENT=
# Relay.link API key — required for fast-fill endpoint (operator feature)
# Obtain from the Relay team. Leave unset to disable fast-fill.
RELAY_API_KEY=

# ──────────── File Upload (self-hosted, no IPFS) ────────────
# Directory to store uploaded images and token metadata JSON files.
# Must be writable by the gateway process.
UPLOAD_DIR=./uploads
# Public base URL used to build URLs returned to the frontend.
# In production: https://api.yourdomain.com
# In development: http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001

# ──────────── Admin Panel ────────────
# Per-IP limit on /auth/nonce and /auth/verify. Defaults (10 per 15 min) are the
# production posture; raise ONLY in dev, where a test suite bursts past it.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

OPRAI_ADMIN_JWT_SECRET=replace-with-your-admin-jwt-secret
# In production set to your public origin, e.g. https://app.oprai.xyz
ADMIN_CORS_ORIGIN=http://localhost:3000
# Initial admin user — created by scripts/db/seed_admin.sh on first deploy.
# Password MUST be at least 16 characters. Generate with: openssl rand -base64 24
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=replace-with-strong-password-min-16-chars

# ──────────── Monitoring (Grafana) ────────────
# Generate with: openssl rand -base64 24
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-grafana-password

# ──────────── Agent Platform ────────────
# Generate with: openssl rand -base64 24
AGENT_DB_PASSWORD=replace-with-agent-db-password
# Generate with: openssl rand -base64 48
AGENT_JWT_SECRET=replace-with-agent-jwt-secret
# AES-256-GCM key for credential encryption. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ──────────── Redis ────────────
REDIS_URL=redis://localhost:6379

# ──────────── Qdrant ────────────
QDRANT_URL=http://localhost:6333

# ──────────── Database URL (composed from above) ────────────
# NOTE: sslmode=disable is for local development only.
# In production, use sslmode=require or sslmode=verify-full.
DATABASE_URL=postgresql://postgres:replace-with-your-db-password@localhost:5433/oprai?sslmode=disable

# ──────────── Knowledge Ingestion ────────────
# When true, the knowledge-ingestion-service runs `crawl_all.main()` on a
# top-of-the-hour cron from inside the FastAPI lifespan. Sources skip
# themselves until their `crawl_freq` window elapses, so the only real work
# every hour is the news feeds; weekly docs run on day 7. docker-compose
# sets this to true by default for the deployed stack.
KNOWLEDGE_CRAWLER_AUTORUN=true
# Monthly OpenAI embedding budget cap (USD). Crawler pauses ingestion when
# month-to-date spend crosses 90% of this and alerts.
KNOWLEDGE_INGESTION_MONTHLY_BUDGET_USD=50

# ──────────── Production: Caddy / Domains ────────────
# Set these when deploying with infra/docker-compose.tls.yml
PUBLIC_DOMAIN=app.oprai.xyz
API_DOMAIN=api.oprai.xyz
ACME_EMAIL=ops@oprai.xyz
# MARKETING_DOMAIN=oprai.xyz       # uncomment when marketing site is added
# PUBLIC_BASE_URL=https://api.oprai.xyz

# ─── Commissions ──────────────────────────────────────────────────────────────
# Where OPRAI's cut of a trade is sent. Leave empty and no fee is taken
# anywhere — every path falls back to its pre-commission behaviour.
#
# Jupiter pays the fee into an associated token account of this wallet, and
# will not create one: the wSOL/USDC/USDT token accounts must exist or that
# swap is simply not charged (the service logs which one is missing).
# Relay's app fee follows this wallet too, unless RELAY_FEE_RECIPIENT is set.
OPRAI_FEE_WALLET=

# Hot wallet that PAYS OUT cashback claims, as a base58-encoded 64-byte secret
# key (the format Phantom/Solflare export). This is the only true PRIVATE KEY
# in OPRAI's configuration — it can move funds. Treat it accordingly:
#   · never commit it, never paste it into a log, ticket or chat
#   · keep only a small float on it; OPRAI_FEE_WALLET stays cold
#   · rotate by funding a new keypair and swapping this value
# Unset or empty = cashback claims are disabled (no crash, the action is simply
# unavailable), which is the correct default for any non-production deployment.
OPRAI_CASHBACK_TREASURY_SECRET=
