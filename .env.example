# OPRAI Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 48   → JWT secrets
#   openssl rand -base64 32   → API keys / internal keys
#   openssl rand -base64 24   → DB passwords
#
# NEVER commit a .env file with real credentials to version control.

# ──────────── Secrets ────────────
OPRAI_JWT_SECRET=replace-with-your-jwt-secret
OPRAI_INTERNAL_API_KEY=replace-with-your-internal-api-key

# ──────────── Database ────────────
DB_SUPERUSER=postgres
DB_SUPERPASS=replace-with-your-db-password
DB_SUPERDB=oprai

# Per-service DB roles — required by: make init-roles
# Generate with: openssl rand -base64 24
AUTH_DB_PASS=replace-with-auth-db-password
CHAT_DB_PASS=replace-with-chat-db-password
SOLANA_DB_PASS=replace-with-solana-db-password
MEMORY_DB_PASS=replace-with-memory-db-password
ADMIN_DB_PASS=replace-with-admin-db-password

# ──────────── CORS ────────────
CORS_ORIGIN=http://localhost:3000

# ──────────── OpenAI ────────────
OPRAI_OPENAI_API_KEY=sk-proj-replace-with-your-openai-key
OPRAI_OPENAI_MODEL=gpt-5.4-nano

# ──────────── Solana ────────────
SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# URL of the TypeScript solana-service used as the Streamflow SDK proxy (runs on :3031)
STREAMFLOW_SDK_URL=http://localhost:3031

# ──────────── Market Data APIs (proxied via gateway) ────────────
BIRDEYE_API_KEY=
JUPITER_API_KEY=
HELIUS_API_KEY=
TENSOR_API_KEY=2b5cf0a7-aae2-4de7-a48c-90026a0642da
# Relay.link app fee recipient — OPRAI wallet address (EVM or Solana)
# When set, 0.05% fee is automatically added to every Relay bridge quote.
RELAY_FEE_RECIPIENT=
# Relay.link API key — required for fast-fill endpoint (operator feature)
# Obtain from the Relay team. Leave unset to disable fast-fill.
RELAY_API_KEY=

# ──────────── File Upload (self-hosted, no IPFS) ────────────
# Directory to store uploaded images and token metadata JSON files.
# Must be writable by the gateway process.
UPLOAD_DIR=./uploads
# Public base URL used to build URLs returned to the frontend.
# In production: https://api.yourdomain.com
# In development: http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001

# ──────────── Admin Panel ────────────
OPRAI_ADMIN_JWT_SECRET=replace-with-your-admin-jwt-secret
ADMIN_CORS_ORIGIN=http://localhost:3200
# Initial admin password — used by scripts/db/seed_admin.sh on first deploy
# Must be at least 16 characters. Generate: openssl rand -base64 24
# ADMIN_INITIAL_USER=admin
# ADMIN_INITIAL_PASSWORD=replace-with-strong-password-min-16-chars

# ──────────── Monitoring (Grafana) ────────────
# Generate with: openssl rand -base64 24
GRAFANA_USER=admin
GRAFANA_PASSWORD=replace-with-grafana-password

# ──────────── Agent Platform ────────────
# Generate with: openssl rand -base64 24
AGENT_DB_PASSWORD=replace-with-agent-db-password
# Generate with: openssl rand -base64 48
AGENT_JWT_SECRET=replace-with-agent-jwt-secret
# AES-256-GCM key for credential encryption. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ──────────── Redis ────────────
REDIS_URL=redis://localhost:6379

# ──────────── Qdrant ────────────
QDRANT_URL=http://localhost:6333

# ──────────── Database URL (composed from above) ────────────
# NOTE: sslmode=disable is for local development only.
# In production, use sslmode=require or sslmode=verify-full.
DATABASE_URL=postgresql://postgres:replace-with-your-db-password@localhost:5433/oprai?sslmode=disable
